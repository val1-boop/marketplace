# Copia este archivo a .env y cambia TODOS los valores. .env nunca se sube al repositorio.
APP_ENV=development

# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
# Opcional (si se omite se deriva de SECRET_KEY)
LOGIN_HMAC_KEY=

# ---------------------------------------------------------------- RDS (Parte 5)
# MySQL rds-mkt-identity-db, base marketplace (users, admin_actions). Usuario mkt_app de aws/sql/01.
# Vacío = SQLite local en instance/marketplace.db
DATABASE_URL=mysql+pymysql://mkt_app:CLAVE_MYSQL@PUNTO-DE-CONEXION-MYSQL:3306/marketplace?charset=utf8mb4&ssl_ca=certs/global-bundle.pem&connect_timeout=10
# PostgreSQL rds-mkt-security-db, base security (login_attempts, auth_events). Usuario mkt_app de aws/sql/02.
# Vacío = SQLite local en instance/security.db
SECURITY_DATABASE_URL=postgresql+psycopg://mkt_app:CLAVE_POSTGRES@PUNTO-DE-CONEXION-POSTGRES:5432/security?sslmode=verify-full&sslrootcert=certs/global-bundle.pem&connect_timeout=10

# ---------------------------------------------------------------- API de productos
# URL de invocación de la etapa $default de apiGatewayMarketplace (sin / al final)
PRODUCTS_API_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com
# El mismo valor que la variable API_TOKEN de la Lambda lambdaAuthorizer
PRODUCTS_API_TOKEN=

# ---------------------------------------------------------------- web
ALLOWED_HOSTS=localhost,127.0.0.1
# true por defecto. Chrome y Firefox aceptan cookies Secure en http://localhost;
# ponlo en false SOLO si tu navegador no guarda la sesión en local por HTTP.
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_COUNT=0

# Usuarios de prueba para `flask --app wsgi seed-demo` (solo desarrollo).
# Define TUS propias contraseñas (mínimo 12 caracteres, 3 de: minúsculas, mayúsculas,
# números y símbolos; que no contengan el correo). No se suben al repositorio.
SEED_ADMIN_EMAIL=admin@marketplace.mx
SEED_ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
SEED_USER_EMAIL=vendedor@marketplace.mx
SEED_USER_PASSWORD=CAMBIA_ESTA_CONTRASENA_VENDEDOR
